{
	"name": "tigergrid",
	"version": "0.1.0",
	"description": "A contribution graph of your AI coding agents (Claude Code, Codex) and AI-assisted commits",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"tigergrid": "src/cli.ts"
	},
	"scripts": {
		"start": "bun src/cli.ts",
		"build": "bun scripts/build.ts",
		"smoke": "bun scripts/smoke.ts",
		"svg": "mkdir -p out && bun src/cli.ts -w 53 --svg out/tigergrid.svg",
		"svg:all": "bun scripts/svg-all.ts",
		"json": "mkdir -p out && bun src/cli.ts -w 53 --json > out/tigergrid.json",
		"test": "bun test",
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"precommit": "bun run format:check && bun run check && bun run lint && bun run test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "latest",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.9",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1"
	}
}
