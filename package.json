{
	"name": "tigergrid",
	"version": "1.1.0",
	"description": "A contribution graph of your AI coding agents (Claude Code, Codex) and AI-assisted commits",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"tigergrid": "dist/node/cli.js"
	},
	"engines": {
		"node": ">=22.17.0"
	},
	"files": [
		"dist/node",
		"LICENSE"
	],
	"scripts": {
		"start": "bun src/cli.ts",
		"build": "bun scripts/build.ts",
		"build:node": "bun build src/cli.ts --target=node --outfile=dist/node/cli.js",
		"prepack": "bun run build:node",
		"smoke": "bun scripts/smoke.ts",
		"svg": "mkdir -p out && bun src/cli.ts -w 53 --svg out/tigergrid.svg",
		"svg:all": "bun scripts/svg-all.ts",
		"json": "mkdir -p out && bun src/cli.ts -w 53 --json > out/tigergrid.json",
		"test": "bun test",
		"test:node": "bun run build:node && TIGERGRID_TEST_NODE=1 bun test test/cli.test.ts",
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"precommit": "bun run format:check && bun run check && bun run lint && bun run test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.3",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2"
	}
}
